# ── Gmail (optional) ────────────────────────────────────────
# GMAIL_CREDENTIALS_FILE=credentials.json

# ── App Settings ────────────────────────────────────────────
APP_LOCK_PASSWORD=
DATABASE_PATH=data/brihaspati.db
DOCUMENTS_DIR=data/documents
VECTOR_INDEX_DIR=data/vector_index
